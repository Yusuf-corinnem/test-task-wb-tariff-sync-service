# Postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# WB
WB_API_KEY=123
WB_API_BASE_URL=https://example.com/api
WB_TIMEOUT=15000
WB_RETRY_ATTEMPTS=3

# Google Sheets Service Account
GOOGLE_CLIENT_EMAIL=test@service.iam.gserviceaccount.com
# Один из вариантов:
# 1) GOOGLE_PRIVATE_KEY with \n for newlines
# 2) GOOGLE_PRIVATE_KEY_BASE64 with base64-encoded key
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nkey==\n-----END PRIVATE KEY-----"
GOOGLE_PRIVATE_KEY_BASE64=key

# Cron
CRON_ENABLED=true
# Каждый час
CRON_SCHEDULE=0 * * * *

# Seeds control (set false to skip automatic seeding on start)
SEEDS_ENABLED=true

APP_PORT=5000
LOG_LEVEL=info