{
    "name": "wb-tariff-sync-service",
    "version": "1.0.0",
    "description": "Сервис синхронизации тарифов WB с Google таблицами",
    "main": "app.js",
    "type": "module",
    "scripts": {
        "dev": "nodemon --watch src --ext ts --exec tsx src/app.ts",
        "build": "tsc",
        "start": "node dist/app.js",
        "knex:dev": "tsx src/utils/knex.ts",
        "test": "jest",
        "test:watch": "jest --watch"
    },
    "imports": {
        "#*": [
            "./dist/*",
            "./src/*"
        ]
    },
    "_moduleAliases": {
        "#": "src"
    },
    "author": "yusuf",
    "license": "ISC",
    "dependencies": {
        "axios": "^1.6.0",
        "commander": "^13.1.0",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "googleapis": "^144.0.0",
        "knex": "^3.0.1",
        "node-cron": "^3.0.3",
        "pg": "^8.11.3",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.11",
        "@types/knex": "^0.16.1",
        "@types/node": "^20.0.0",
        "@types/node-cron": "^3.0.11",
        "@types/pg": "^8.11.10",
        "jest": "^29.7.0",
        "nodemon": "^3.0.2",
        "ts-jest": "^29.1.1",
        "tsx": "^4.20.4",
        "typescript": "^5.7.3"
    }
}